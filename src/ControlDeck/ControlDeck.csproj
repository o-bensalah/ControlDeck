<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 wants DPI awareness set via WinForms' ApplicationHighDpiMode instead of the
         manifest, but we have no WinForms UI (UseWindowsForms is only here for Screen
         enumeration) — the manifest's Per-Monitor-V2 setting is what KioskWindowPlacementService
         actually needs and must stay.
         NU1701 flags AudioSwitcher.AudioApi(.CoreAudio) as .NET-Framework-only with no net8.0
         asset — there's no newer build targeting net8+, but it's been exercised through several
         real build/run/output-switch cycles on this TFM (including under load: mid-switch races
         and reentrant COM callbacks that needed their own fixes) with no compatibility issues, so
         the warning is a generic mismatch notice, not a detected problem. -->
    <NoWarn>$(NoWarn);WFAC010;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF + UseWindowsForms both contribute implicit global usings that collide
         (UserControl, Application, etc.) — drop the WinForms one; it's only needed
         locally in KioskWindowPlacementService.cs for Screen enumeration. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built into the assembly (not copied loose to the output folder) so the app's built-in
         defaults can never go missing or get out of sync with the exe — ControlDeckConfig reads
         this back via GetManifestResourceStream, the single source of truth for defaults instead
         of a hardcoded C# array. -->
    <EmbeddedResource Include="Assets\defaults.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" Version="3.0.3" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>
