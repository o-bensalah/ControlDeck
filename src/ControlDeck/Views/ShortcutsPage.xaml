<UserControl x:Class="ControlDeck.Views.ShortcutsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>

        <UniformGrid Grid.Column="0" Rows="2" Columns="3" Margin="0,0,30,0">
            <Button Content="PrtScn" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="PrintScreen_Click"/>
            <Button Content="Lock" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="Lock_Click"/>
            <Button Content="Show Desktop" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="ShowDesktop_Click"/>
            <Button Content="Sleep" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="Sleep_Click"/>
            <Button Content="Task Manager" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="TaskManager_Click"/>
            <Button Content="File Explorer" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="FileExplorer_Click"/>
        </UniformGrid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Slider x:Name="VolumeSlider" Grid.Row="0" Style="{StaticResource VolumeSliderStyle}"
                    AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="0"
                    ValueChanged="VolumeSlider_ValueChanged" Margin="0,10,0,10"
                    HorizontalAlignment="Center" Width="48"/>
            <ToggleButton x:Name="MuteButton" Grid.Row="1" Content="Mute" Style="{StaticResource MuteToggleStyle}"
                          Click="MuteButton_Click"/>
        </Grid>
    </Grid>
</UserControl>
