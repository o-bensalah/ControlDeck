<UserControl x:Class="ControlDeck.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <UniformGrid x:Name="ShortcutsGrid" Columns="4"/>
            <TextBlock x:Name="LaunchStatusText" Text="" Foreground="{StaticResource DangerBrush}"
                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
        </Grid>

        <UniformGrid Grid.Row="1" Rows="1" Columns="6">
            <Border Style="{StaticResource CompactTileStyle}" Margin="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CPU" Style="{StaticResource CompactTileTitleStyle}"/>
                    <TextBlock x:Name="CpuLoadText" Text="—" Style="{StaticResource CompactTileValueStyle}"/>
                    <TextBlock x:Name="CpuTempText" Text="—" Style="{StaticResource CompactTileDetailStyle}"/>
                    <ProgressBar x:Name="CpuLoadBar" Style="{StaticResource CompactLoadBarStyle}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CompactTileStyle}" Margin="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GPU" Style="{StaticResource CompactTileTitleStyle}"/>
                    <TextBlock x:Name="GpuLoadText" Text="—" Style="{StaticResource CompactTileValueStyle}"/>
                    <TextBlock x:Name="GpuTempText" Text="—" Style="{StaticResource CompactTileDetailStyle}"/>
                    <ProgressBar x:Name="GpuLoadBar" Style="{StaticResource CompactLoadBarStyle}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CompactTileStyle}" Margin="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MEM" Style="{StaticResource CompactTileTitleStyle}"/>
                    <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource CompactTileValueStyle}" FontSize="15"/>
                    <TextBlock x:Name="MemoryPercentText" Text="—" Style="{StaticResource CompactTileDetailStyle}"/>
                    <ProgressBar x:Name="MemoryBar" Style="{StaticResource CompactLoadBarStyle}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CompactTileStyle}" Margin="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DISK" Style="{StaticResource CompactTileTitleStyle}"/>
                    <TextBlock x:Name="DiskText" Text="—" Style="{StaticResource CompactTileValueStyle}"/>
                    <TextBlock x:Name="DiskTempText" Text="—" Style="{StaticResource CompactTileDetailStyle}"/>
                    <ProgressBar x:Name="DiskBar" Style="{StaticResource CompactLoadBarStyle}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CompactTileStyle}" Margin="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NETWORK" Style="{StaticResource CompactTileTitleStyle}"/>
                    <TextBlock x:Name="NetworkDownText" Text="↓ —" Style="{StaticResource CompactTileValueStyle}" FontSize="15"/>
                    <TextBlock x:Name="NetworkUpText" Text="↑ —" Style="{StaticResource CompactTileDetailStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CompactTileStyle}" Margin="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="UPTIME" Style="{StaticResource CompactTileTitleStyle}"/>
                    <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource CompactTileValueStyle}" FontSize="16"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="&#9198;" Style="{StaticResource TransportButtonStyle}"
                    Margin="0,0,10,0" Click="PreviousTrack_Click"/>
            <ToggleButton x:Name="PlayPauseButton" Grid.Column="1" Style="{StaticResource PlayPauseButtonStyle}"
                          Margin="0,0,10,0" Click="PlayPause_Click"/>
            <Button Grid.Column="2" Content="&#9197;" Style="{StaticResource TransportButtonStyle}"
                    Margin="0,0,24,0" Click="NextTrack_Click"/>

            <ToggleButton x:Name="MuteButton" Grid.Column="3" Content="Mute" Style="{StaticResource MuteToggleStyle}"
                          Width="80" Margin="0,0,16,0" Click="MuteButton_Click"/>
            <Slider x:Name="VolumeSlider" Grid.Column="4" Style="{StaticResource VolumeSliderStyle}"
                    AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="0"
                    ValueChanged="VolumeSlider_ValueChanged" Height="40" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
