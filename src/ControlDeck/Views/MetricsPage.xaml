<UserControl x:Class="ControlDeck.Views.MetricsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="30">
        <UniformGrid Rows="2" Columns="3">
            <Border Style="{StaticResource TileStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CPU" Style="{StaticResource TileTitleStyle}"/>
                    <TextBlock x:Name="CpuLoadText" Text="—" Style="{StaticResource TileValueStyle}"/>
                    <TextBlock x:Name="CpuTempText" Text="—" Style="{StaticResource TileDetailStyle}"/>
                    <ProgressBar x:Name="CpuLoadBar" Style="{StaticResource LoadBarStyle}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GPU" Style="{StaticResource TileTitleStyle}"/>
                    <TextBlock x:Name="GpuLoadText" Text="—" Style="{StaticResource TileValueStyle}"/>
                    <TextBlock x:Name="GpuTempText" Text="—" Style="{StaticResource TileDetailStyle}"/>
                    <ProgressBar x:Name="GpuLoadBar" Style="{StaticResource LoadBarStyle}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MEMORY" Style="{StaticResource TileTitleStyle}"/>
                    <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource TileValueStyle}" FontSize="28"/>
                    <TextBlock x:Name="MemoryPercentText" Text="—" Style="{StaticResource TileDetailStyle}"/>
                    <ProgressBar x:Name="MemoryBar" Style="{StaticResource LoadBarStyle}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DISK" Style="{StaticResource TileTitleStyle}"/>
                    <TextBlock x:Name="DiskText" Text="—" Style="{StaticResource TileValueStyle}"/>
                    <TextBlock x:Name="DiskTempText" Text="—" Style="{StaticResource TileDetailStyle}"/>
                    <ProgressBar x:Name="DiskBar" Style="{StaticResource LoadBarStyle}" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NETWORK" Style="{StaticResource TileTitleStyle}"/>
                    <TextBlock x:Name="NetworkDownText" Text="↓ —" Style="{StaticResource TileValueStyle}" FontSize="26"/>
                    <TextBlock x:Name="NetworkUpText" Text="↑ —" Style="{StaticResource TileDetailStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileStyle}" Margin="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="UPTIME" Style="{StaticResource TileTitleStyle}"/>
                    <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource TileValueStyle}" FontSize="30"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
