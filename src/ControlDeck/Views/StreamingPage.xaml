<UserControl x:Class="ControlDeck.Views.StreamingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid x:Name="PickerGrid" Margin="30">
            <UniformGrid Rows="2" Columns="3">
                <Button Content="Cinejoy" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="StreamOne_Click"/>
                <Button Content="Rive" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="StreamTwo_Click"/>
                <Button Content="NTV Stream" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="StreamThree_Click"/>
                <Button Content="StreamSports" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="StreamFour_Click"/>
                <Button Content="LiveLive24" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="StreamFive_Click"/>
                <Button Content="Daddy Live" Style="{StaticResource DeckButtonStyle}" Margin="12" Click="StreamSix_Click"/>
            </UniformGrid>
        </Grid>

        <Grid x:Name="BrowserGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#8249;" Style="{StaticResource NavArrowStyle}"
                        Width="44" Height="44" Margin="6" Opacity="1" Click="SiteBack_Click"/>
                <Button Grid.Column="1" Content="&#8962;" Style="{StaticResource NavArrowStyle}"
                        Width="44" Height="44" Margin="6" Opacity="1" Click="Home_Click"/>
                <TextBlock x:Name="CurrentServiceText" Grid.Column="2" Text=""
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="16"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
            </Grid>

            <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
        </Grid>
    </Grid>
</UserControl>
