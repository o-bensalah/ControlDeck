<Window x:Class="ControlDeck.Views.KioskExitOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlDeck"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="64" Height="64"
        WindowStartupLocation="Manual">
    <!-- Floats above the external kiosk browser window (which has no chrome/close button of its
         own) so a touchscreen user with no keyboard has a way back to the deck. -->
    <Button Content="&#8962;" Style="{StaticResource NavArrowStyle}"
            Width="56" Height="56" Opacity="0.85" Click="ExitButton_Click"/>
</Window>
