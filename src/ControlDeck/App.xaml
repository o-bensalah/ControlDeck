<Application x:Class="ControlDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ControlDeck"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#151B23"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1E2731"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4FD1C5"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#2C5A56"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B96A5"/>
        <!-- Both measured against the dots' own opaque SurfaceBrush pill (SwipeContainer.xaml),
             not against page backgrounds directly — 9.28:1 / 5.77:1, comfortably clear of the
             3:1 floor for graphical indicators. -->
        <SolidColorBrush x:Key="DotActiveBrush" Color="#4FD1C5"/>
        <SolidColorBrush x:Key="DotInactiveBrush" Color="#8B96A5"/>
        <!-- Darkened from the original #E5484D: that measured 3.91:1 as error text on the white
             page background, under the 4.5:1 AA body-text target. This value clears both of its
             uses — 5.3:1 as text-on-white, 4.48:1 for the icon-on-this-as-a-button-background
             case (mute button's muted state) — verified, not eyeballed. -->
        <SolidColorBrush x:Key="DangerBrush" Color="#C93038"/>

        <Style x:Key="DeckButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavArrowStyle" TargetType="Button" BasedOn="{StaticResource DeckButtonStyle}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Opacity" Value="0.55"/>
            <!-- Own template rather than just inheriting DeckButtonStyle's: a single glyph
                 character (‹ › ✕) doesn't sit centered in its own line box — most fonts' glyphs
                 read slightly high within the ascent/descent box, leaving more visual gap above
                 than below when centered "correctly" by layout math. The extra bottom margin
                 compensates; scoped to this style alone so it doesn't shift the icon+label
                 shortcut buttons, which don't have the same single-glyph asymmetry. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MuteToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- Self-contained: the speaker icon (body + 0-3 sound-wave arcs / crossed-out
                             when muted) and "Mute" label are baked into the template itself, not
                             passed in as Content, so every consumer gets the same dynamic icon for
                             free. Wave1/2/3 opacity is driven from code-behind (volume level), not
                             a trigger here — only the muted crossover and background react to
                             IsChecked directly. -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="30" Height="20" Margin="0,0,8,0">
                                    <Polygon Points="1,6 6,6 11,1 11,19 6,14 1,14" Fill="{StaticResource TextPrimaryBrush}"/>
                                    <Path x:Name="Wave1" Data="M 13,7 A 3,3 0 0 1 13,13"
                                          Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path x:Name="Wave2" Data="M 15,4 A 6,6 0 0 1 15,16"
                                          Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path x:Name="Wave3" Data="M 17,1 A 9,9 0 0 1 17,19"
                                          Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Grid x:Name="MutedIcon" Opacity="0">
                                        <Line X1="13" Y1="4" X2="25" Y2="16" Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="25" Y1="4" X2="13" Y2="16" Stroke="{StaticResource TextPrimaryBrush}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Text="Mute" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                                <Setter TargetName="MutedIcon" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MicMuteToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- Mic mute is a plain on/off toggle (no level meter like the speaker's
                             0-3 waves), so a single IsChecked trigger crossing the glyph out is
                             enough — no code-behind needed to drive the icon, unlike MuteToggleStyle. -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="22" Height="20" Margin="0,0,8,0">
                                    <Rectangle Width="10" Height="12" RadiusX="5" RadiusY="5"
                                               HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Fill="{StaticResource TextPrimaryBrush}"/>
                                    <Path Data="M 3,9 A 8,8 0 0 0 19,9" Stroke="{StaticResource TextPrimaryBrush}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="11" Y1="17" X2="11" Y2="20" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"/>
                                    <Line X1="6" Y1="20" X2="16" Y2="20" Stroke="{StaticResource TextPrimaryBrush}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line x:Name="MutedSlash" X1="2" Y1="1" X2="20" Y2="19"
                                          Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0"/>
                                </Grid>
                                <TextBlock Text="Mic" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                                <Setter TargetName="MutedSlash" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinSliderRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Height="8" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClassicVolumeThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{StaticResource TextPrimaryBrush}"
                                 Stroke="{StaticResource AccentBrush}" StrokeThickness="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!-- RepeatButtons are pinned to a thin centered 8px line; the Thumb is
                             taller and centers independently on top, so it isn't clipped by the
                             thin track like a shared-height design would. -->
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ThinSliderRepeatButtonStyle}"
                                                  Background="{StaticResource AccentBrush}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ThinSliderRepeatButtonStyle}"
                                                  Background="{StaticResource SurfaceHoverBrush}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ClassicVolumeThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource DeckButtonStyle}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <Style x:Key="PlayPauseButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="32">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="IconScale"/>
                                </Grid.RenderTransform>
                                <Path x:Name="PlayIcon" Data="M 2,0 L 2,20 L 18,10 Z" Stretch="Uniform"
                                      Fill="{StaticResource TextPrimaryBrush}" Width="18" Height="18"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Grid x:Name="PauseIcon" Opacity="0" Width="18" Height="18"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Fill="{StaticResource TextPrimaryBrush}" Width="6"
                                               HorizontalAlignment="Left"/>
                                    <Rectangle Fill="{StaticResource TextPrimaryBrush}" Width="6"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PlayIcon" Storyboard.TargetProperty="Opacity"
                                                              To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="PauseIcon" Storyboard.TargetProperty="Opacity"
                                                              To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="1.25"/>
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="1.25"/>
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PlayIcon" Storyboard.TargetProperty="Opacity"
                                                              To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="PauseIcon" Storyboard.TargetProperty="Opacity"
                                                              To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="1.25"/>
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="1.25"/>
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="20,18"/>
        </Style>

        <Style x:Key="TileTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TileValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="TileDetailStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="LoadBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track" Background="Transparent"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactTileStyle" TargetType="Border" BasedOn="{StaticResource TileStyle}">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="8,8"/>
        </Style>

        <Style x:Key="CompactTileTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TileTitleStyle}">
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="CompactTileValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TileValueStyle}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="CompactTileDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource TileDetailStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="CompactLoadBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource LoadBarStyle}">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Application.Resources>
</Application>
