<UserControl x:Class="ControlDeck.Controls.MediaWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Collapsed (zero height, since Auto sizes to a Collapsed child's zero DesiredSize)
             whenever nothing is playing anywhere, so it doesn't leave a gap above the controls.
             Wrapped in a SurfaceBrush card, same as every other text-bearing element in the app —
             TextPrimaryBrush/TextSecondaryBrush are light colors meant for a dark surface, not
             the page's white background directly. -->
        <Border x:Name="NowPlayingPanel" Grid.Row="0" Margin="0,0,0,12" Padding="12" CornerRadius="16"
                Background="{StaticResource SurfaceBrush}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" ClipToBounds="True"
                        Background="{StaticResource SurfaceHoverBrush}">
                    <Image x:Name="NowPlayingArt" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="NowPlayingTitle" Text="" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NowPlayingArtist" Text="" FontSize="13" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="&#9198;" Style="{StaticResource TransportButtonStyle}"
                    Margin="0,0,10,0" Click="PreviousTrack_Click"/>
            <ToggleButton x:Name="PlayPauseButton" Grid.Column="1" Style="{StaticResource PlayPauseButtonStyle}"
                          Margin="0,0,10,0" Click="PlayPause_Click"/>
            <Button Grid.Column="2" Content="&#9197;" Style="{StaticResource TransportButtonStyle}"
                    Margin="0,0,24,0" Click="NextTrack_Click"/>

            <ToggleButton x:Name="MuteButton" Grid.Column="3" Style="{StaticResource MuteToggleStyle}"
                          Width="104" Margin="0,0,16,0" Click="MuteButton_Click"/>
            <Slider x:Name="VolumeSlider" Grid.Column="4" Style="{StaticResource VolumeSliderStyle}"
                    AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="0"
                    ValueChanged="VolumeSlider_ValueChanged" Height="40" VerticalAlignment="Center"/>

            <ToggleButton x:Name="MicMuteButton" Grid.Column="5" Style="{StaticResource MicMuteToggleStyle}"
                          Width="96" Margin="16,0,0,0" Click="MicMuteButton_Click"/>

            <Button x:Name="OutputDeviceButton" Grid.Column="6" Content="&#128266;"
                    Style="{StaticResource TransportButtonStyle}" Margin="10,0,0,0"
                    Click="OutputDeviceButton_Click"/>
        </Grid>

        <!-- Popup rather than an inline expanding panel — the device list is short-lived and
             shouldn't push the rest of the control row around when it opens. StaysOpen="False" so
             a tap anywhere else (including another page after a swipe) dismisses it. -->
        <Popup x:Name="OutputDevicePopup" Grid.Row="1" PlacementTarget="{Binding ElementName=OutputDeviceButton}"
               Placement="Top" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="10"
                    BorderBrush="{StaticResource SurfaceHoverBrush}" BorderThickness="1.5">
                <StackPanel x:Name="OutputDeviceList" MinWidth="240"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
