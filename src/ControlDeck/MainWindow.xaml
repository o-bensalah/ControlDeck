<Window x:Class="ControlDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ControlDeck.Controls"
        Title="ControlDeck"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="White">
    <Grid x:Name="RootGrid"
          MouseMove="OnRootMouseMove"
          PreviewTouchDown="OnRootPreviewTouchDown"
          PreviewTouchMove="OnRootPreviewTouchMove"
          PreviewTouchUp="OnRootPreviewTouchUp">
        <controls:SwipeContainer x:Name="Deck"/>

        <Button x:Name="CloseButton" Content="&#10005;" Style="{StaticResource NavArrowStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                Opacity="0" IsHitTestVisible="False"
                Click="OnCloseButtonClick"/>
    </Grid>
</Window>
